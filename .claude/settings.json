{
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Edit(~/.azure/**)",
      "Read(~/.kube/**)",
      "Edit(~/.kube/**)",
      "Read(~/.oci/**)",
      "Edit(~/.oci/**)",
      "Read(~/.docker/config.json)",
      "Edit(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Edit(~/.netrc)",
      "Read(~/.git-credentials)",
      "Edit(~/.git-credentials)",
      "Read(~/.config/gh/**)",
      "Edit(~/.config/gh/**)",
      "Read(~/.npmrc)",
      "Edit(~/.npmrc)",
      "Read(~/.pypirc)",
      "Edit(~/.pypirc)",
      "Read(~/.config/anthropic/**)",
      "Edit(~/.config/anthropic/**)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Edit(~/.claude.json)",
      "Read(~/.codex/**)",
      "Edit(~/.codex/**)",
      "Read(~/.gemini/**)",
      "Edit(~/.gemini/**)",
      "Read(~/.bash_history)",
      "Edit(~/.bash_history)",
      "Read(~/.zsh_history)",
      "Edit(~/.zsh_history)",
      "Read(~/.python_history)",
      "Edit(~/.python_history)",
      "Read(~/.psql_history)",
      "Edit(~/.psql_history)",
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./.env.*)",
      "Edit(./.env.*)",
      "Read(./**/.env)",
      "Edit(./**/.env)",
      "Read(./**/.env.*)",
      "Edit(./**/.env.*)",
      "Read(./**/*.pem)",
      "Edit(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./**/*.key)",
      "Read(./**/*.p12)",
      "Edit(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Edit(./**/*.pfx)",
      "Read(./**/*.jks)",
      "Edit(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Edit(./**/*.keystore)",
      "Read(./**/id_rsa)",
      "Edit(./**/id_rsa)",
      "Read(./**/id_rsa.*)",
      "Edit(./**/id_rsa.*)",
      "Read(./**/id_ed25519)",
      "Edit(./**/id_ed25519)",
      "Read(./**/id_ed25519.*)",
      "Edit(./**/id_ed25519.*)",
      "Read(./**/id_ecdsa)",
      "Edit(./**/id_ecdsa)",
      "Read(./**/id_ecdsa.*)",
      "Edit(./**/id_ecdsa.*)",
      "Read(./**/*service-account*.json)",
      "Edit(./**/*service-account*.json)",
      "Read(./**/*credentials*.json)",
      "Edit(./**/*credentials*.json)",
      "Read(./**/secrets.*)",
      "Edit(./**/secrets.*)",
      "Read(./**/*.secret)",
      "Edit(./**/*.secret)",
      "Read(./**/*.tfstate)",
      "Edit(./**/*.tfstate)",
      "Read(./**/*.tfstate.*)",
      "Edit(./**/*.tfstate.*)",
      "Read(./**/.pgpass)",
      "Edit(./**/.pgpass)",
      "Read(./**/.my.cnf)",
      "Edit(./**/.my.cnf)",
      "Read(./**/.vault-token)",
      "Edit(./**/.vault-token)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/security-guardrails/scripts/guard-sensitive-paths.py\"",
            "statusMessage": "Checking path against security guardrails"
          }
        ]
      }
    ]
  }
}
