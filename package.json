{
  "name": "oc-lens",
  "version": "0.3.2",
  "private": false,
  "description": "Local, read-only analytics dashboard for opencode",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibrahimkobeissy/oc-lens.git"
  },
  "homepage": "https://github.com/ibrahimkobeissy/oc-lens#readme",
  "bugs": {
    "url": "https://github.com/ibrahimkobeissy/oc-lens/issues"
  },
  "keywords": [
    "opencode",
    "analytics",
    "dashboard",
    "sqlite",
    "cli"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@11.18.0",
  "bin": {
    "oc-lens": "bin/cli.js"
  },
  "files": [
    "bin/cli.js",
    "bin/cli-lib.js",
    "bin/prepare-standalone.js",
    ".next/standalone"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:dist": "next build && node bin/prepare-standalone.js",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixture": "tsx test/fixtures/build-fixture.ts",
    "prepack": "pnpm build:dist"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "next": "16.3.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^6",
    "vitest": "^4.1.8"
  }
}
